        3072,
        4320
      ],
      "nativeDetailGuarantee": "Each scene must be independently rendered at native resolution; composite raster dimensions or upscaling alone are not proof",
      "gridOrder": "LEFT_TO_RIGHT_TOP_TO_BOTTOM",
      "absentLastCell": "UNUSED_NEUTRAL_CELL_NEVER_SCENE",
      "requiredChecks": [
        "realIndependentWebpFiles",
        "eachNativeFrameDimensions",
        "perFrame16by9",
        "actualOriginalBytesAndSha256",
        "identityAndTextFreeHumanQA",
