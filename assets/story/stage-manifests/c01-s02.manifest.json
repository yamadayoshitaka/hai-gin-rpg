    "heroGenderIsolation": true,
    "noCrossOutcomeReuse": true,
    "noEarlyVictory": true,
    "oneBeatPerCell": true,
    "continuity": "previous and following canonical screenplay beats",
    "narrationDisplay": "outside illustration in game UI",
    "proofing": "manual visual acceptance; OCR optional only, not assumed",
    "priority": "P0_ABSOLUTE_MUST_FOLLOW",
    "mandatoryActualByteAttachments": true,
    "noTextIncludesGameScreenshots": true,
    "onViolation": "REJECTED_NO_REGISTRATION_OR_DEPLOYMENT"
