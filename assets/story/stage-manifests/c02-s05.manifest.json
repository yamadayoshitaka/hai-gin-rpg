      "titles",
      "chapter banners",
      "scene identifiers",
      "comic panel labels",
      "subtitles",
      "speech bubbles",
      "ruby",
      "legible markings on parchment or seals",
      "tables",
      "production reports",
      "infographics",
      "mock UI",
      "interface buttons",
      "watermarks",
      "logos",
      "developer notes",
      "JSON code"
    ],
    "identityLock": "each visible actor must match supplied real master image bytes, never invent cast from names alone",
    "heroGenderIsolation": true,
    "noCrossOutcomeReuse": true,
    "noEarlyVictory": true,
    "oneBeatPerCell": true,
    "continuity": "previous and following canonical screenplay beats",
    "narrationDisplay": "outside illustration in game UI",
    "proofing": "manual visual acceptance; OCR optional only, not assumed",
    "priority": "P0_ABSOLUTE_MUST_FOLLOW",
    "mandatoryActualByteAttachments": true,
    "noTextIncludesGameScreenshots": true,
    "onViolation": "REJECTED_NO_REGISTRATION_OR_DEPLOYMENT"
  },
  "operatingOrder": [
    "load full stage screenplay",
    "expand all 8 gender/outcome variants",
    "freeze exact storyboard action for every cell",
    "attach real cast image files",
    "P0 gate: every actor's real image bytes must be attached, otherwise BLOCKED (path strings do not count)",
    "P0 prompt: prepend mandatory absolute textless/cast-identity/canonical-scene rules to every shot and variant render prompt",
    "independently render one native-resolution 16:9 WebP per canonical scene with real character master bytes (if image generator connected)",
    "assemble approved native WebP frames into 2-column x up-to-5-row lossless review-only sheets (up to 10; never use a low-resolution contact sheet as the original)",
    "for bulk review queues: at most 100 authentic independent WebPs, 10 sheets of up to 10, with deterministic batch indices; do not pad stage2's 48 canonically defined scenes",
    "if a native high-res input sheet is supplied, cut only when per-cell native pixels exceed minimum; otherwise BLOCKED_LOW_RES",
    "check native pixels and provenance",
    "review each cell vs its exact screenplay and approved reference",
    "register only approved individual files",
    "P0 visual review: REJECT any incorrect cast, UI/text/number, narrative mismatch or low-quality source; no autopromote",
    "deploy after all variant checks pass"
